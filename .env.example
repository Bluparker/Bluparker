# Amadeus API credentials
# Sign up at https://developers.amadeus.com/ (free test tier available)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# "test" uses Amadeus sandbox (fictional data, free).
# Switch to "production" once you have live API access.
AMADEUS_HOSTNAME=test

# --- WhatsApp (via Twilio) ---
# Sign up at https://www.twilio.com/ and enable the WhatsApp Sandbox.
# Sandbox sender:  whatsapp:+14155238886  (free testing)
# Production:      your approved WhatsApp Business number
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated list of recipient numbers (with country code, whatsapp: prefix)
# e.g.  whatsapp:+12125551234,whatsapp:+447911123456
TWILIO_WHATSAPP_TO=whatsapp:+your_number

# --- Telegram (optional — can run alongside WhatsApp) ---
# 1. Create a bot via @BotFather on Telegram to get the token.
# 2. Start a chat with your bot, then get the chat ID via:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id

# Optional overrides
DB_PATH=flight_history.db
CONFIG_PATH=config.yaml
